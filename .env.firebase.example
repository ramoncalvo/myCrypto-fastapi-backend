# Firebase Configuration Example
# Copy this to .env and fill in your Firebase project details

# Environment
ENVIRONMENT=production

# Database Configuration
DATABASE_TYPE=firebase

# Firebase Project Configuration
FIREBASE_PROJECT_ID=your-firebase-project-id

# Option 1: Use service account file (recommended for local development)
FIREBASE_CREDENTIALS_PATH=path/to/your/serviceAccountKey.json

# Option 2: Use service account JSON string (recommended for production/cloud)
# FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"your-project",...}

# JWT Configuration (keep these secure in production)
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Instructions:
# 1. Create a Firebase project at https://console.firebase.google.com/
# 2. Enable Firestore Database
# 3. Generate a service account key:
#    - Go to Project Settings > Service Accounts
#    - Click "Generate new private key"
#    - Download the JSON file
# 4. Set FIREBASE_PROJECT_ID to your project ID
# 5. Set FIREBASE_CREDENTIALS_PATH to the downloaded JSON file path
# 6. Update JWT_SECRET_KEY with a secure random string
