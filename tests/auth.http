### Authentication API Tests
### Base URL: {{baseUrl}}

### 1. Register New User
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "testuser@example.com",
  "name": "Test User",
  "password": "securepassword123"
}

> {%
client.test("User registration", function() {
    client.assert(response.status === 200, "Response status is not 200");
    client.assert(response.body.email, "Email not found");
    client.assert(response.body.id, "User ID not found");
});
%}

###

### 2. Login User and Capture Tokens
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "testuser@example.com",
  "password": "securepassword123"
}

> {%
client.test("User login", function() {
    client.assert(response.status === 200, "Response status is not 200");
    client.assert(response.body.access_token, "Access token not found");
    client.assert(response.body.refresh_token, "Refresh token not found");
    
    // Store tokens for subsequent requests
    client.global.set("access_token", response.body.access_token);
    client.global.set("refresh_token", response.body.refresh_token);
});
%}

###

### 3. Login with Demo User and Capture Tokens
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "demo@mycrypto.com",
  "password": "demo123"
}

> {%
client.test("Demo user login", function() {
    client.assert(response.status === 200, "Response status is not 200");
    client.assert(response.body.access_token, "Access token not found");
    client.assert(response.body.refresh_token, "Refresh token not found");
    
    // Store demo tokens for testing
    client.global.set("access_token", response.body.access_token);
    client.global.set("refresh_token", response.body.refresh_token);
});
%}

###

### 4. Get User Profile (Protected Route)
GET {{baseUrl}}/auth/profile
Authorization: Bearer {{access_token}}

> {%
client.test("Get user profile", function() {
    client.assert(response.status === 200, "Response status is not 200");
    client.assert(response.body.email, "Email not found");
    client.assert(response.body.id, "User ID not found");
});
%}

###

### 5. Verify Token
GET {{baseUrl}}/auth/verify
Authorization: Bearer {{access_token}}

> {%
client.test("Verify token", function() {
    client.assert(response.status === 200, "Response status is not 200");
    client.assert(response.body.valid === true, "Token is not valid");
    client.assert(response.body.user, "User object not found");
});
%}

###

### 6. Refresh Token and Update Access Token
POST {{baseUrl}}/auth/refresh
Content-Type: application/json

{
  "refresh_token": "{{refresh_token}}"
}

> {%
client.test("Refresh token", function() {
    client.assert(response.status === 200, "Response status is not 200");
    client.assert(response.body.access_token, "New access token not found");
    client.assert(response.body.refresh_token, "New refresh token not found");
    
    // Update tokens with new ones
    client.global.set("access_token", response.body.access_token);
    client.global.set("refresh_token", response.body.refresh_token);
});
%}

###

### 7. Logout User
POST {{baseUrl}}/auth/logout
Authorization: Bearer {{access_token}}

> {%
client.test("User logout", function() {
    client.assert(response.status === 200, "Response status is not 200");
    client.assert(response.body.message, "Logout message not found");
});
%}

###

### ========================================
### ERROR SCENARIOS
### ========================================

### Register with Existing Email
POST http://localhost:8000/auth/register
Content-Type: application/json

{
  "email": "demo@mycrypto.com",
  "name": "Duplicate User",
  "password": "password123"
}

###

### Login with Wrong Password
POST http://localhost:8000/auth/login
Content-Type: application/json

{
  "email": "demo@mycrypto.com",
  "password": "wrongpassword"
}

###

### Login with Non-existent User
POST http://localhost:8000/auth/login
Content-Type: application/json

{
  "email": "nonexistent@example.com",
  "password": "password123"
}

###

### Access Protected Route without Token
GET http://localhost:8000/auth/profile

###

### Access Protected Route with Invalid Token
GET http://localhost:8000/auth/profile
Authorization: Bearer invalid_token_here

###

### Refresh with Invalid Token
POST http://localhost:8000/auth/refresh
Content-Type: application/json

{
  "refresh_token": "invalid_refresh_token"
}

###
