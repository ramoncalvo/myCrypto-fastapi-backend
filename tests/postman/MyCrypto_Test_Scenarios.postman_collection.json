{
	"info": {
		"_postman_id": "test-scenarios-uuid",
		"name": "MyCrypto Test Scenarios",
		"description": "Complete workflow and error handling test scenarios for MyCrypto API",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Complete User Portfolio Flow",
			"item": [
				{
					"name": "1. Create User",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"User created successfully\", function () {",
									"    pm.response.to.have.status(200);",
									"    const responseJson = pm.response.json();",
									"    pm.environment.set('testUserId', responseJson.id);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"alice@crypto.com\",\n  \"name\": \"Alice Johnson\",\n  \"password\": \"mySecurePassword123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/users/",
							"host": ["{{baseUrl}}"],
							"path": ["users", ""]
						}
					}
				},
				{
					"name": "2. Create Bitcoin Asset",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Bitcoin asset created\", function () {",
									"    pm.response.to.have.status(200);",
									"    const responseJson = pm.response.json();",
									"    pm.environment.set('testBtcId', responseJson.id);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"symbol\": \"BTC\",\n  \"name\": \"Bitcoin\",\n  \"current_price\": 45000.00\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/crypto-assets/",
							"host": ["{{baseUrl}}"],
							"path": ["crypto-assets", ""]
						}
					}
				},
				{
					"name": "3. Create Portfolio Entry",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Portfolio entry created\", function () {",
									"    pm.response.to.have.status(200);",
									"    const responseJson = pm.response.json();",
									"    pm.environment.set('testPortfolioId', responseJson.id);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"user_id\": \"{{testUserId}}\",\n  \"asset_id\": \"{{testBtcId}}\",\n  \"quantity\": 0.5,\n  \"purchase_price\": 44000.00\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/portfolio/",
							"host": ["{{baseUrl}}"],
							"path": ["portfolio", ""]
						}
					}
				},
				{
					"name": "4. Get User Portfolio",
					"request": {
						"method": "GET",
						"header": [{"key": "Accept", "value": "application/json"}],
						"url": {
							"raw": "{{baseUrl}}/portfolio/user/{{testUserId}}",
							"host": ["{{baseUrl}}"],
							"path": ["portfolio", "user", "{{testUserId}}"]
						}
					}
				}
			]
		},
		{
			"name": "Error Handling Tests",
			"item": [
				{
					"name": "Duplicate Email Registration",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Duplicate email rejected\", function () {",
									"    pm.response.to.have.status(400);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{"key": "Content-Type", "value": "application/json"}],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"alice@crypto.com\",\n  \"name\": \"Another Alice\",\n  \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/users/",
							"host": ["{{baseUrl}}"],
							"path": ["users", ""]
						}
					}
				},
				{
					"name": "Non-existent User",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Non-existent user returns 404\", function () {",
									"    pm.response.to.have.status(404);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [{"key": "Accept", "value": "application/json"}],
						"url": {
							"raw": "{{baseUrl}}/users/nonexistent_id",
							"host": ["{{baseUrl}}"],
							"path": ["users", "nonexistent_id"]
						}
					}
				}
			]
		}
	]
}
